# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Similarity threshold for the soft photo-duplicate warning (0-64, lower = stricter).
# pHash distance; 8-10 is a reasonable starting point for "probably the same object".
PHASH_WARNING_THRESHOLD=8

# Supabase project settings -> API. All photo/document storage goes through
# Supabase Storage — required, no local-disk fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STORAGE_BUCKET=onekey-media
