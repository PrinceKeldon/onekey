# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # storage uploads — admin, keep secret
SUPABASE_ANON_KEY=your-anon-key                    # session verification only — safe to expose client-side too

STORAGE_BUCKET=onekey-media

# Similarity threshold for the soft photo-duplicate warning (0-64, lower = stricter).
PHASH_WARNING_THRESHOLD=8

# Transactional ownership-transfer email delivery (Resend)
RESEND_API_KEY=re_your-api-key
EMAIL_FROM=ONEKEY <memory@one-key.tech>
PUBLIC_APP_URL=https://onekey-keldontechnolog.vercel.app
TRANSFER_EXPIRY_HOURS=24
