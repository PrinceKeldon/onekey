NEXT_PUBLIC_API_URL=http://localhost:8000

# Project Settings -> API. The anon key is safe to expose client-side by
# design (Supabase's row-level security, not secrecy, is what protects data) —
# it's only used here to send magic-link/OTP emails and hold the browser session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
